{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/asuka1975/harness-testing-framework/main/contract/formats/label.schema.json",
    "title": "Label",
    "description": "人手のラベルの一行（JSON Lines）。コーパスの項目に正しいクラスを付ける",
    "type": "object",
    "properties": {
        "item": {
            "type": "string",
            "minLength": 1
        },
        "label": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "labeler": {
            "type": "string",
            "minLength": 1
        }
    },
    "required": [
        "item",
        "label",
        "labeler"
    ],
    "additionalProperties": false
}
