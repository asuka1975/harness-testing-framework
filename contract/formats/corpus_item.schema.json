{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/asuka1975/harness-testing-framework/main/contract/formats/corpus_item.schema.json",
    "title": "Corpus item",
    "description": "分類器の検証のコーパスの一行（JSON Lines）。分類器が見た状態文書と選択肢",
    "type": "object",
    "properties": {
        "item": {
            "type": "string",
            "minLength": 1
        },
        "scope": {
            "enum": [
                "stage",
                "phase"
            ]
        },
        "target": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "options": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]*$"
                    },
                    "description": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "description"
                ],
                "additionalProperties": false
            }
        },
        "state": {
            "type": "string"
        },
        "source": {
            "description": "どの実行のどの評価から取ったか（任意）",
            "type": "object"
        }
    },
    "required": [
        "item",
        "scope",
        "target",
        "options",
        "state"
    ],
    "additionalProperties": false
}
